{
    "name": "freeremote-server",
    "version": "1.0.0",
    "private": true,
    "description": "the server for freeremote, an open source, radio-agnostic program for remote station control.",
    "license": "0BSD",
    "repository": "github:parabirb/freeremote-server",
    "homepage": "https://github.com/parabirb/freeremote-server#readme",
    "bugs": "https://github.com/parabirb/freeremote-server/issues",
    "author": "parabirb",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "generate-keys": "tsx src/generate-keys.ts",
        "audio-devices": "tsx src/get-audio-devices.ts",
        "typecheck": "tsc --noEmit",
        "lint": "xo && prettier --check .",
        "lint:fix": "xo --fix && prettier --write .",
        "test": "npm run typecheck && npm run lint",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@discordjs/builders": "^1.10.1",
        "@ngrok/ngrok": "^1.4.1",
        "audify": "^1.9.0",
        "discord.js": "^14.18.0",
        "ft8js": "^0.0.2",
        "joi": "^17.13.3",
        "lowdb": "^7.0.1",
        "openpgp": "^6.1.0",
        "socket.io": "^4.8.1",
        "xmlrpc": "^1.3.2"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "@types/xmlrpc": "^1.3.10",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "xo": "^5.0.1"
    }
}
